      {
        "id": "smsmyrjf4fcb0a",
        "title": "An Unexpected Party",
        "blurb": "",
        "cards": [
          {
            "text": "In a hole in the ground there lived a Hobbit . . .",
            "cardId": "0365c439-30bf-4d32-a791-166751bdb996"
